[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/unibots/backup.env
ExecStart=/usr/local/sbin/unibots-host-check
StateDirectory=unibots/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/unibots/alerts
ProtectHome=true
PrivateTmp=true
