[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/unibots-host-alert backup-failure "Nightly backup failed. Inspect unibots-backup.service on the server."
StateDirectory=unibots/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/unibots/alerts
PrivateTmp=true
