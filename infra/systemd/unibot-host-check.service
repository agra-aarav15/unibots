[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/unibot/backup.env
ExecStart=/usr/local/sbin/unibot-host-check
StateDirectory=unibot/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/unibot/alerts
ProtectHome=true
PrivateTmp=true
