---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const starsLabel = await githubStarsLabel();
---

<BaseLayout title="Support · Unibots" description="Get help with the Unibots app and self-hosted Unibots.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Unibots support</h1>
      <p>
        Open an issue on the <a href="https://github.com/agra-aarav15/unibots/issues">public issue tracker</a>. Say what you expected to
        happen and what happened instead. Never paste passwords, API keys, access tokens, or other
        secrets into an issue.
      </p>
      <h2>Self-hosted Unibots</h2>
      <p>
        Start with the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>. For reproducible bugs or feature requests,
        open an issue in the <a href={`${GITHUB_URL}/issues`}>Unibots GitHub repository</a>.
      </p>
      <h2 id="account-deletion">Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. On the web, sign in to your deployment and do the same
        under <strong>Settings</strong> → <strong>Account</strong>. This permanently deletes the account and its
        associated personal Space data.
      </p>
      <p>Sign-in security records are kept for up to 90 days.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>
